    <!-- '맨 위로' 버튼 HTML -->
    <div id="back-to-top" aria-label="맨 위로 이동"></div>

    <style>
        /* '맨 위로' 버튼 스타일 */
        #back-to-top {
            position: fixed;
            bottom: 20px; /* 화면 하단에서 20px 위로 이동 */
            right: 20px;  /* 화면 오른쪽에서 20px 왼쪽으로 이동 */
            display: none; /* 기본적으로 숨김 */
            width: 35px;    /* 기존 50px에서 약 70%로 축소 */
            height: 35px;   /* 기존 50px에서 약 70%로 축소 */
            border: 2px solid #132844; /* 테두리 색상 */
            background-color: #ffffff;  /* 배경색 */
            color: #132844;             /* 화살표 색상 */
            border-radius: 50%;         /* 원형 버튼 */
            text-align: center;
            line-height: 31px;          /* 화살표 수직 중앙 정렬 (height - border) */
            cursor: pointer;
            z-index: 1000;              /* 다른 요소 위에 표시 */
            transition: opacity 0.3s ease;
            box-shadow: 0 2px 5px rgba(0, 0, 0, 0.3); /* 약간의 그림자 추가 */
        }

        /* 버튼에 마우스를 올렸을 때 약간의 배경색 변화 */
        #back-to-top:hover {
            background-color: #f0f0f0;
        }

        /* 위쪽 화살표 추가 */
        #back-to-top:after {
            content: "\25B2"; /* 위쪽 화살표 유니코드 */
            font-size: 16px;  /* 기존 20px에서 축소 */
        }

        /* 반응형 조정 (모바일 등) */
        @media (max-width: 768px) {
            #back-to-top {
                width: 30px;
                height: 30px;
                bottom: 15px;
                right: 15px;
                line-height: 26px;
            }

            #back-to-top:after {
                font-size: 14px;
            }
        }
    </style>

    <script>
        (function() {
            var backToTop = document.getElementById('back-to-top');

            // 스크롤 이벤트 리스너
            window.addEventListener('scroll', function() {
                if (window.scrollY > window.innerHeight) { // 화면 높이보다 스크롤이 많이 되었을 때
                    backToTop.style.display = 'block';
                } else {
                    backToTop.style.display = 'none';
                }
            });

            // 버튼 클릭 시 최상단으로 이동
            backToTop.addEventListener('click', function() {
                window.scrollTo({ top: 0, behavior: 'auto' }); // 애니메이션 없이 즉시 이동
            });
        })();
    </script>
        <style>
        #loading-spinner {
            display: none;
            position: fixed;
            left: 50%;
            top: 50%;
            transform: translate(-50%, -50%);
            border: 8px solid #f3f3f3;
            border-radius: 50%;
            border-top: 8px solid #132844;
            width: 50px;
            height: 50px;
            animation: spin 1s linear infinite;
            z-index: 9999;
            box-sizing: border-box;
            max-width: 100%;
            max-height: 100%;
        }

        /* 작은 화면 (예: 모바일)에서의 추가 조정 */
        @media screen and (max-width: 768px) {
            #loading-spinner {
                width: 40px;
                height: 40px;
                border-width: 6px;
                left: calc(50% - 20px);
                top: calc(50% + 0px);
            }
        }

        @keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }
    </style>


<div id="loading-spinner"></div>

<script>
    jQuery(document).ready(function($) {
        function startLoadingSpinner() {
            $('#loading-spinner').show(); // 로딩 스피너 표시
        }

        function stopLoadingSpinner() {
            $('#loading-spinner').hide(); // 로딩 스피너 숨김
        }

        // 모든 AJAX 요청에 대해 로딩 스피너 처리, 특정 요청에서는 비활성화
        $(document).on('ajaxSend', function(event, jqxhr, settings) {
            // 'track_post_views' 액션이 아닌 경우에만 로딩 스피너 표시
            if (settings.data && settings.data.indexOf('action=track_post_views') === -1) {
                startLoadingSpinner();  // 로딩 스피너 표시
            }
        });

        $(document).on('ajaxComplete ajaxError', function(event, jqxhr, settings) {
            // 'track_post_views' 액션이 아닌 경우에만 로딩 스피너 숨김
            if (settings.data && settings.data.indexOf('action=track_post_views') === -1) {
                stopLoadingSpinner();  // 로딩 스피너 숨김
            }
        });
    });
