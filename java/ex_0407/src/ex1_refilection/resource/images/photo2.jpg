<script>
  function isMyAppWebView() {
    var userAgent = navigator.userAgent || navigator.vendor || window.opera;
    return userAgent.indexOf('gklibrarykorWebView') > -1;
  }

  function isMainPage() {
    return window.location.pathname === '/' || window.location.pathname === '/index.html';
  }

  if (isMyAppWebView()) {
    // 앱 내 웹뷰일 경우: PayPal 버튼과 GoogleplaySidebarBanner를 숨김
    var style = document.createElement('style');
    style.innerHTML = `
      .GoogleplaySidebarBanner,
      #paypal-container-C8AR9RXGNJERS {
        display: none !important;
      }
    `;
    document.head.appendChild(style);
  } else {
    // 앱 내 웹뷰가 아닌 경우: PayPal 버튼을 표시하고 스크립트를 로드
    var style = document.createElement('style');
    style.innerHTML = `
      #paypal-container-C8AR9RXGNJERS {
        display: block !important;
      }
    `;
    document.head.appendChild(style);

    var paypalScript = document.createElement('script');
    paypalScript.src = "https://www.paypal.com/sdk/js?client-id=BAA8VDrIA-ZqibiJS1WwDgqMys_3vBoEQUoYq2DlXe-HqWogbz8ckFzE4sKrXFUzI-54qKoR-xfF1CkC30&components=hosted-buttons&disable-funding=venmo¤cy=USD";
    paypalScript.onload = function() {
      console.log("PayPal script loaded");
      paypal.HostedButtons({
        hostedButtonId: "C8AR9RXGNJERS",
      }).render("#paypal-container-C8AR9RXGNJERS").then(function() {
        console.log("PayPal button rendered");
      }).catch(function(error) {
        console.error("PayPal button rendering failed", error);
      });
    };
    document.head.appendChild(paypalScript);

    if (isMainPage()) {
      // 메인 페이지에서는 GoogleplaySidebarBanner를 표시
      var mainStyle = document.createElement('style');
      mainStyle.innerHTML = `
        .GoogleplaySidebarBanner {
          display: block !important;
        }
      `;
      document.head.appendChild(mainStyle);
    } else {
      // 웹뷰도 아니고 메인 페이지도 아닌 경우: 광고 스크립트 로드
      var adsScript = document.createElement('script');
      adsScript.async = true;
      adsScript.src = "https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-9210888059325515";
      adsScript.crossOrigin = "anonymous";
      document.head.appendChild(adsScript);
    }
  }
</script>






